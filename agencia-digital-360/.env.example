# ============================================================================
# AGENCIA DIGITAL 360 (Execution Module) — Environment Template
# Timezone: VET (America/Caracas, UTC-04:00) | Zero-C-Drive Cache Strategy
# ============================================================================

# --- 1. Core Runtime & VET Timezone ---
APP_ENV=development
APP_PORT=8090
TZ=America/Caracas
UTC_OFFSET_HOURS=-4
AG360_MASTER_VAULT_SECRET=change-this-32-byte-master-vault-secret-in-prod!!

# --- 2. Disk Protection (Zero-C-Drive Bloat on Local Windows) ---
LOCAL_INBOX_DIR=E:\Agencia_Inbox
AG360_STORAGE_DIR=E:\05_Proyectos\proyecto p2p\agencia-digital-360\storage
PIP_CACHE_DIR=E:\05_Proyectos\proyecto p2p\agencia-digital-360\storage\cache\pip
HF_HOME=E:\05_Proyectos\proyecto p2p\agencia-digital-360\storage\cache\huggingface
TORCH_HOME=E:\05_Proyectos\proyecto p2p\agencia-digital-360\storage\cache\torch

# --- 3. Database (Supabase PostgreSQL — 100% Decoupled from ARM DB) ---
SUPABASE_DB_URL=postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ_replace_with_supabase_service_role_key
PUBLIC_MEDIA_BUCKET_URL=https://project-ref.supabase.co/storage/v1/object/public/agencia360-media
PUBLIC_MEDIA_BUCKET_NAME=agencia360-media

# --- 4. Async Queue & MoneyPrinterTurbo V1 (Concurrency = 1) ---
REDIS_URL=redis://localhost:6389/0
VIDEO_WORKER_CONCURRENCY=1
MONEYPRINTER_API_URL=http://localhost:8085
MONEYPRINTER_CUSTOM_AUDIO_PATCH=true
WHISPER_MODEL_SIZE=large-v3-turbo
WHISPER_COMPUTE_TYPE=int8

# --- 5. AI Stack (Venezuela & LATAM Compatible Only) ---
GEMINI_API_KEY=AIzaSy_replace_with_gemini_pro_key
GEMINI_MODEL_NAME=gemini-1.5-pro
OPENAI_API_KEY=sk-proj-replace_with_openai_key
OPENAI_COPY_MODEL=gpt-4o
NANO_BANANA_API_KEY=nb_live_replace_with_nano_banana_key
NANO_BANANA_API_URL=https://api.nanobanana.ai/v1/generations

# --- 6. Ad Platforms (Default Global Fallbacks — Per-Brand Credentials Stored in brands Table) ---
META_GRAPH_API_VERSION=v21.0
META_APP_ID=replace_with_meta_app_id
META_APP_SECRET=replace_with_meta_app_secret
META_AD_LIBRARY_ACCESS_TOKEN=replace_with_meta_ad_library_token
YOUTUBE_API_KEY=AIzaSy_replace_with_youtube_data_v3_key
TIKTOK_APP_ID=replace_with_tiktok_app_id
TIKTOK_APP_SECRET=replace_with_tiktok_app_secret

# --- 7. Decoupled ARM Bridge (Webhooks & REST JSON Only) ---
ARM_WEBHOOK_OUTBOUND_URL=http://localhost:3030/api/arm/webhooks/ad-attribution
ARM_WEBHOOK_HMAC_SECRET=replace_with_shared_arm_agencia360_hmac_secret
ARM_WEBHOOK_REPLAY_WINDOW_SECONDS=300

# --- 8. Mobile Command Center (Telegram HITL Bot) ---
TELEGRAM_BOT_TOKEN=1234567890:AAF_replace_with_agencia360_bot_token
TELEGRAM_AUTHORIZED_CHAT_ID=replace_with_operator_telegram_chat_id
TELEGRAM_WEBHOOK_SECRET=replace_with_telegram_webhook_secret
