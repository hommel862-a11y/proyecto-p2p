{
  "manifest_version": 3,
  "name": "P2P Radar HUD - Tactical Arbitrage Overlay",
  "version": "1.0.0",
  "description": "Ultra-light real-time decision HUD over Binance P2P powered by P2P Decisor Core Engine.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://p2p.binance.com/*",
    "http://localhost:4200/*",
    "http://127.0.0.1:4200/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:4200/*",
        "http://127.0.0.1:4200/*",
        "http://localhost:8080/*",
        "http://127.0.0.1:8080/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://p2p.binance.com/*"
      ],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "P2P Radar HUD Status",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
