# =================================================================
# CONFIGURACIÓN DEL CENTINELA DE TELEGRAM 2.0 (MODALIDAD CLOUD VPS)
# =================================================================

# 1. Token de tu Bot de Telegram obtenido de @BotFather (OBLIGATORIO)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# 2. Tu Chat ID Personal de Telegram para restringir el acceso y recibir alertas (OBLIGATORIO)
TELEGRAM_CHAT_ID=123456789

# 3. API Key de CotizaVe para consulta de tasas BCV y Paralelo en vivo (RECOMENDADO)
COTIZAVE_API_KEY=tu_api_key_de_cotizave

# 4. Frecuencia de escaneo proactivo de arbitraje en segundos (Default: 30s)
ALPHA_SCAN_INTERVAL_SEC=30

# 5. Margen mínimo neto (%) para disparo de alerta proactiva de arbitraje (Default: 1.0%)
MIN_NET_SPREAD_PCT=1.0
