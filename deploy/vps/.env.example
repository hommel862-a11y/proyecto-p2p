# =================================================================
# CONFIGURACIÓN DEL SERVIDOR CLOUD VPS (4 MÓDULOS DE ALTO IMPACTO)
# =================================================================

# 1. Token de tu Bot de Telegram de @BotFather (OBLIGATORIO)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# 2. Tu Chat ID Personal de Telegram para control y alertas (OBLIGATORIO)
TELEGRAM_CHAT_ID=123456789

# 3. API Key de CotizaVe para tasas BCV y Paralelo en vivo (RECOMENDADO)
COTIZAVE_API_KEY=tu_api_key_de_cotizave

# 4. Frecuencia de escaneo proactivo de arbitraje y Data Lake (Default: 15s)
ALPHA_SCAN_INTERVAL_SEC=15

# 5. Margen mínimo neto (%) para alertas proactivas (Default: 1.0%)
MIN_NET_SPREAD_PCT=1.0

# 6. Motor de Reprecio Autónomo 24/7 (Fase 2)
AUTOREPRICE_ENABLED=false
AUTOREPRICE_MIN_SPREAD_PCT=0.6
AUTOREPRICE_BREAKEVEN_PRICE=0.0

# 7. Gateway de Inteligencia Artificial Centralizado (Fase 3)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
ANTHROPIC_API_KEY=

# 8. Puerto HTTP REST API (Fases 1, 2, 3 y 4)
PORT=3000

# 9. ARM Multi-Workspace & Meta Cloud API Gateway (24/7 Omnichannel)
INBOUND_GATEWAY_PORT=3030
META_APP_SECRET=
META_VERIFY_TOKEN=p2p-verify-secret
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID_B2B=
META_PHONE_NUMBER_ID_P2P=
META_PHONE_NUMBER_ID_360=

# 10. PostgreSQL 17 + pgvector (CRM / ARM Silo Persistence & Outbox LISTEN/NOTIFY)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=arm_multi_workspace
POSTGRES_PORT=5432
# En Docker Compose usa el hostname del servicio ("postgres").
# Sin Docker (Opción B - Managed PostgreSQL en Supabase / Neon):
#   - Supabase Session Pooler o Direct (SIEMPRE puerto 5432, NUNCA 6543 porque corta LISTEN/NOTIFY SSE):
#     DATABASE_URL=postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#   - Neon Direct (preferir URL directa sin -pooler y sin scale-to-zero agresivo):
#     DATABASE_URL=postgresql://<user>:<PASSWORD>@<endpoint>.neon.tech/<db>?sslmode=require
# Opcional TLS para poolers con CA propia (recomendado pasar ruta al certificado CA, o no-verify en pruebas):
# DATABASE_SSL_CA_PATH=
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/arm_multi_workspace
