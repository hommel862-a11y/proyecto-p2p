# =================================================================
# CONFIGURACIÓN DEL SERVIDOR CLOUD VPS (4 MÓDULOS DE ALTO IMPACTO)
# =================================================================

# 1. Token de tu Bot de Telegram de @BotFather (OBLIGATORIO)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# 2. Tu Chat ID Personal de Telegram para control y alertas (OBLIGATORIO)
TELEGRAM_CHAT_ID=123456789

# 3. API Key de CotizaVe para tasas BCV y Paralelo en vivo (RECOMENDADO)
COTIZAVE_API_KEY=tu_api_key_de_cotizave

# 4. Frecuencia de escaneo proactivo de arbitraje y Data Lake (Default: 15s)
ALPHA_SCAN_INTERVAL_SEC=15

# 5. Margen mínimo neto (%) para alertas proactivas (Default: 1.0%)
MIN_NET_SPREAD_PCT=1.0

# 6. Motor de Reprecio Autónomo 24/7 (Fase 2)
AUTOREPRICE_ENABLED=false
AUTOREPRICE_MIN_SPREAD_PCT=0.6
AUTOREPRICE_BREAKEVEN_PRICE=0.0

# 7. Gateway de Inteligencia Artificial Centralizado (Fase 3)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
ANTHROPIC_API_KEY=

# 8. Puerto HTTP REST API (Fases 1, 2, 3 y 4)
PORT=3000
